# MultiHopper API Configuration
MULTIHOPPER_API_URL=https://api.multihopper.com
MULTIHOPPER_API_KEY=your_multihopper_api_key_here
MULTIHOPPER_PARTNER_ID=your_partner_referral_id_here

# Solana Network Configuration (devnet | mainnet-beta)
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Solana Wallet Configuration (base58 encoded private key)
SOLANA_PRIVATE_KEY=your_base58_solana_private_key_here

# Disperser Security Settings
# Delay between routed transfers in seconds (jitter for anti-timing correlation)
ROUTING_JITTER_SECONDS=15

